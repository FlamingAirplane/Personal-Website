generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/adine_portfolio/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model PortfolioItem {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String?
  imageUrl    String?
  projectLink String?
  year        Int
  type        String   @default("game") // game, sound, other
  tags        String?
  sortOrder   Int      @default(0)
  slug        String?  @unique
  subpageContent String? // rich text / markdown for subpage
  galleryImages  String? // JSON array of image URLs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([year])
  @@index([slug])
}

model WorkHistory {
  id          String   @id @default(cuid())
  company     String
  position    String
  description String?
  startDate   String
  endDate     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  dotLink   String?
  message   String?
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model SiteProfile {
  id       String  @id @default(cuid())
  name     String
  tagline  String?
  bio      String?
  email    String?
  phone    String?
  imageUrl String?
  resumeCloudStoragePath String?
  resumeIsPublic         Boolean @default(true)
  twitterUrl  String?
  instagramUrl String?
  heroBgUrl    String?
}

model SiteSettings {
  id                  String  @id @default(cuid())
  particleMouseRadius Int     @default(70)
  particlePushForce   Int     @default(8)
  particleReturnSpeed Int     @default(6) // stored as x100
  particleFriction    Int     @default(85) // stored as x100
  particleGap         Int     @default(3)
  titleText           String  @default("Adine.")
  cursorEnabled       Boolean @default(true)
  cursorSize          Int     @default(12)
  cursorHoverSize     Int     @default(40)
  cursorLag           Int     @default(15) // stored as x100 (0.15)
  cursorColorLight    String  @default("#0a0c04")
  cursorColorDark     String  @default("#c8d4a8")
  updatedAt           DateTime @updatedAt
}
